# ====================================================
# 가족여행 플래너 - 환경변수 설정 예시
# 이 파일을 복사해 .env 로 저장한 뒤 실제 키를 입력하세요.
# ====================================================

# --------------------------------------------------
# [프론트엔드] 카카오지도 JavaScript API 키
# https://developers.kakao.com → 내 애플리케이션 → 앱 키 → JavaScript 키
# --------------------------------------------------
VITE_KAKAO_MAP_KEY=여기에_카카오_JavaScript_앱키_입력

# --------------------------------------------------
# [서버사이드] 한국관광공사 TourAPI 4.0 서비스 키
# https://www.data.go.kr → 한국관광공사_국문 관광정보 서비스_v2 신청
# --------------------------------------------------
TOUR_API_KEY=여기에_공공데이터포털_서비스키_입력

# --------------------------------------------------
# [서버사이드] 카카오 REST API 키 (길찾기 Directions API용)
# https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
# --------------------------------------------------
KAKAO_REST_API_KEY=여기에_카카오_REST_API키_입력

# --------------------------------------------------
# [서버사이드] OpenAI API 키 (AI 에이전트용)
# https://platform.openai.com/api-keys
# --------------------------------------------------
OPENAI_API_KEY=sk-여기에_OpenAI_API키_입력

# OpenAI 모델 설정 (기본: gpt-4o)
OPENAI_MODEL=gpt-4o

# --------------------------------------------------
# API 서버 포트 (기본: 3001)
# --------------------------------------------------
API_PORT=3001
